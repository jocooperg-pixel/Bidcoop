    "tipoNombre": "Licitación Pública >1000 UTM",
    "titulo": "Sistema de Monitoreo de Área y Neutrones",
    "organismo": "Comisión Chilena de Energía Nuclear",
    "organismoRut": "82.983.100-7",
    "organismoPagoDias": null,
    "organismoRiesgo": "Sin evaluar",
