    "tipoNombre": "Licitación Pública >1000 UTM",
    "titulo": "ADQUISICIÓN DE SOLUCIÓN XDR PARA CIBERSEGURIDAD AVANZADA SERVICIO DE SALUD MAULE",
    "organismo": "SERVICIO DE SALUD DEL MAULE",
    "organismoRut": "61.606.900-4",
