    "rutOrganismo": "65.075.485-9",
    "tipoOficial": "LP",
    "tipoNombre": "Licitación Pública >100 UTM",
    "titulo": "AUDÍFONO PEDIÁTRICO HIPOACUSIA PARA EL HLF",
    "organismo": "HOSPITAL CLINICO METROPOLITANO DE LA FLORIDA DOCTORA ELOISA DIAZ",
    "organismoRut": "65.075.485-9",
