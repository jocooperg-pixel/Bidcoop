    "organismoRiesgo": "Sin evaluar",
    "rubro": "Artículos de Escritorio y Oficina",
    "region": "Región de Antofagasta ",
    "monto": 0,
    "amount": null,
    "amountType": "no_informado",
    "currency": "CLP",
    "fechaPublicacion": "2026-06-04T16:03:00",
