    "tipoNombre": "Licitación Pública >1000 UTM",
    "titulo": "Servicios de elaboracion de materiales promocionales modalidad suministro destinados a las distintas actividades institucionales",
    "organismo": "DIRECCION GENERAL DE PROMOCION DE EXPORTACIONES",
    "organismoRut": "62.000.680-7",
    "organismoPagoDias": null,
