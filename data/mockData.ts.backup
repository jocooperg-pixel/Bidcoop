    "tipoNombre": "Licitación Internacional",
    "titulo": "Servicio de Arriendo de Infraestructura Data Center y Servidores para el HDS",
    "organismo": "SERVICIO DE SALUD ORIENTE HOSPITAL DEL SALVADOR",
    "organismoRut": "61.608.406-2",
