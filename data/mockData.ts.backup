    "tipoNombre": "Licitación Pública >1000 UTM",
    "titulo": "Producción de evento Parque de la Chilenidad 2026",
    "organismo": "ILUSTRE MUNICIPALIDAD DE QUILLON",
    "organismoRut": "69.141.400-0",
    "organismoPagoDias": 30,
    "organismoRiesgo": "Bajo",
