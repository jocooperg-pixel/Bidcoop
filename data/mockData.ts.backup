    "rutOrganismo": "69.070.400-5",
    "tipoOficial": "LR",
    "tipoNombre": "Licitación Privada",
    "titulo": "CENTRAL TÉRMICA DE CLIMATIZACIÓN PARA EDIFICIO",
    "organismo": "I MUNICIPALIDAD DE LAS CONDES",
    "organismoRut": "69.070.400-5",
    "organismoPagoDias": null,
    "organismoRiesgo": "Sin evaluar",
    "rubro": "Artículos de Escritorio y Oficina",
    "region": "Región Metropolitana de Santiago",
    "monto": 11100,
    "amount": 11100,
    "amountType": "monto_estimado",
    "currency": "UTM",
    "fechaPublicacion": "2026-10-30T17:48:35.293",
    "fechaCierre": "2026-11-30T15:01:00",
    "matchScore": 60,
    "matchKeywords": [
      "climatización"
    ],
    "riesgo": "Sin evaluar",
    "descripcion": "La presente licitación tiene por objeto contratar la renovación de equipos de climatización (Chiller,\r\nTorres de enfriamiento, bombas y piping e interconexiones) para edificio Consistorial de la\r\nMunicipalidad de Las Condes, ubicado en Av. Apoquindo N°3400, las Condes.\r\nLas presentes Bases regirán para la implementación de esta renovación de equipos y sistemas, las\r\nobras civiles, el conexionado, pruebas y puesta en marcha del sistema que permita mantener un\r\nnivel servicio y confort adecuado para la condición de climatización en frío del edificio.",
    "estado": "Publicada",
