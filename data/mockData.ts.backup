    "tipoNombre": "Licitación Pública >1000 UTM",
    "titulo": "Adquisición de equipos informáticos para el programa Oficina Local de la Niñez",
    "organismo": "I MUNICIPALIDAD DE VILLA ALEMANA",
    "organismoRut": "69.061.500-2",
