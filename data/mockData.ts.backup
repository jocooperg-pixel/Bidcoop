    "tipoNombre": "Licitación Pública >1000 UTM",
    "titulo": "Aumento de Cámaras de Televigilancia en Puntos Est",
    "organismo": "I MUNICIPALIDAD DE RIO HURTADO",
    "organismoRut": "69.041.000-1",
    "organismoPagoDias": null,
    "organismoRiesgo": "Sin evaluar",
