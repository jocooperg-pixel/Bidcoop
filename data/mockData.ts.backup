    "titulo": "SERV. MÉDICOS NEUROMONITOREO INTRAOPERATORIO HDFRZ",
    "organismo": "SERVICIO DE SALUD DEL LIBERTADOR B O'HIGGINS HOSPITAL REG RANCAGUA",
    "organismoRut": "61.602.138-9",
    "organismoPagoDias": null,
    "organismoRiesgo": "Sin evaluar",
    "rubro": "Artículos de Escritorio y Oficina",
    "region": "Región del Libertador General Bernardo O´Higgins",
    "monto": 0,
    "amount": null,
    "amountType": "no_informado",
    "currency": "CLP",
    "fechaPublicacion": "2026-09-02T19:59:22.11",
