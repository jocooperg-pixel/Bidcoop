    "titulo": "ADQUISICIÓN DE TEST DE DIAGNÓSTICO MOLECULAR PARA LA CARACTERIZACIÓN DE BIOMARCADORES TUMORALES",
    "organismo": "SERVICIO DE SALUD DEL MAULE HOSPITAL DE TALCA",
    "organismoRut": "61.606.901-2",
    "organismoPagoDias": null,
    "organismoRiesgo": "Sin evaluar",
    "rubro": "Artículos de Escritorio y Oficina",
    "region": "Región del Maule ",
    "monto": 0,
