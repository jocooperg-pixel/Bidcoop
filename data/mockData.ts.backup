    "titulo": "PPTA 75-26 “ADQUISICIÓN TALONARIOS FORMULARIOS IMPRESOS PARA EL HOSPITAL DR. HERNÁN HENRÍQUEZ ARAVENA”",
    "organismo": "HOSPITAL DOCTOR HERNAN HENRIQUEZ ARAVENA",
    "organismoRut": "61.602.232-6",
    "organismoPagoDias": null,
    "organismoRiesgo": "Sin evaluar",
