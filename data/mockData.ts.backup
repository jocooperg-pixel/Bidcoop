    "currency": "CLP",
    "fechaPublicacion": "2026-09-03T13:03:45.813",
    "fechaCierre": "2026-09-28T15:01:00",
    "matchScore": 98,
    "matchKeywords": [
      "servidor",
      "monitor",
      "monitores",
      "teclado",
