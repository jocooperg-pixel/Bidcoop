    "tipoNombre": "Licitación Privada",
    "titulo": "ADQUISICIÓN DE SUMINISTRO DE BAJADAS PARA ADMINISTRAR SOLUCIONES DEDICADAS Y UNIVERSALES CON COMODATO DE EQUIPOS",
    "organismo": "Instituto de Neurocirugía",
