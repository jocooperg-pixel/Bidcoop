    "tipoNombre": "Licitación Pública >1000 UTM",
    "titulo": "CÁMARAS DE VIGILANCIA E INSUMOS TECNOLÓGICOS.",
    "organismo": "I MUNICIPALIDAD DE LONGAVI",
    "organismoRut": "69.130.600-3",
