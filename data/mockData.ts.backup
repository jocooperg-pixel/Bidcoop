    "tipoNombre": "Licitación de Obras",
    "titulo": "Actividades de Reconocimiento de la Oficina de la Mujer",
    "organismo": "I MUNICIPALIDAD DE PUERTO VARAS",
    "organismoRut": "69.220.200-7",
    "organismoPagoDias": null,
    "organismoRiesgo": "Sin evaluar",
    "rubro": "Artículos de Escritorio y Oficina",
    "region": "Región de los Lagos ",
    "monto": 0,
    "amount": null,
    "amountType": "no_informado",
