    "tipoNombre": "Licitación Pública >1000 UTM",
    "titulo": "“CONVENIO COMPRA DE SERVICIO PROFESIONAL TECNÓLOGO MÉDICO MENCIÓN OFTALMOLOGÍA TMO PARA LA ATENCIÓN DE VICIO DE REFRACCIÓN EN ADULTO MAYOR DE 65 AÑOS GES Y ATENCIÓN Y PREPARACIÓN USUARIOS EN LISTA DE ESPERA DE PTERIGIÓN EN ADULTOS”  brd",
    "organismo": "HOSPITAL CLINICO HERMINDA MARTIN",
    "organismoRut": "61.607.001-0",
    "organismoPagoDias": 30,
    "organismoRiesgo": "Bajo",
