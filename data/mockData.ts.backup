    "tipoNombre": "Licitación Pública >1000 UTM",
    "titulo": "ADQUISICIÓN DE VILDAGLIPTINA 50MG PARA LA RED DE ATENCIÓN PRIMARIA - DGR",
    "organismo": "SERVICIO DE SALUD ACONCAGUA",
    "organismoRut": "61.606.700-1",
    "organismoPagoDias": 30,
    "organismoRiesgo": "Bajo",
    "rubro": "Artículos de Escritorio y Oficina",
