    "titulo": "Encuesta Percepción Administración Tributaria Chil",
    "organismo": "SUBSECRETARIA DEL MINISTERIO DE HACIENDA",
    "organismoRut": "60.801.000-9",
    "organismoPagoDias": null,
    "organismoRiesgo": "Sin evaluar",
    "rubro": "Artículos de Escritorio y Oficina",
