    "titulo": "SUMINISTRO DE AUDÍFONOS POR 6 MESES",
    "organismo": "CENTRO DE REFERENCIA DE SALUD HOSPITAL PROVINCIA CORDILLERA",
    "organismoRut": "61.980.620-4",
