    "tipoNombre": "Licitación Pública >1000 UTM",
    "titulo": "SERVICIO DE RENOVACIÓN DE SUSCRIPCIONES TÉCNICAS",
    "organismo": "DIRECCION DE LOGISTICA DE CARABINEROS",
