    "tipoNombre": "Licitación Pública >1000 UTM",
    "titulo": "HABILITACIÓN DE EQUIPO DE AIRE ACONDICIONADO",
    "organismo": "I MUNICIPALIDAD DE ARICA",
    "organismoRut": "69.010.100-9",
    "organismoPagoDias": null,
    "organismoRiesgo": "Sin evaluar",
